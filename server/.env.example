DATABASE_URL="postgresql://resto:resto@localhost:5432/restoapp?schema=public"
PORT=4000
# Secret de signature des sessions (≥ 32 caractères aléatoires). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Valeur d'exemple refusée en production (NODE_ENV=production) ; ailleurs, secret temporaire.
JWT_SECRET="changez-moi-en-production"
# Origines autorisées pour le front (séparées par des virgules)
CORS_ORIGIN="http://localhost:5173"

# En-tête des tickets de caisse
RESTAURANT_NAME="Mon Restaurant"
RESTAURANT_ADDRESS="Avenue Kwame Nkrumah, Ouagadougou"
RESTAURANT_PHONE="+226 25 00 00 00"
RESTAURANT_NIF="00012345X"
RESTAURANT_RCCM="BF-OUA-2026-B-0000"
RECEIPT_FOOTER="Merci de votre visite et à bientôt !"
RECEIPT_FOOTER_EN="Thank you for your visit, see you soon!"
CURRENCY_LABEL="FCFA"

# Fuseau horaire du restaurant (statistiques par jour / par heure)
APP_TIMEZONE="Africa/Ouagadougou"

# --- Sécurité ---
# Cookie de session « Secure » (HTTPS). Laisser à true en production ; false uniquement
# pour tester depuis une tablette en http://IP-locale (les navigateurs refusent sinon le cookie).
COOKIE_SECURE=true
# Déconnexion serveur après N minutes sans requête (le verrouillage écran intervient avant)
SESSION_IDLE_MINUTES=30
# Remise cumulée maximale accordable par un caissier (% de l'addition), au-delà : gérant
MAX_CASHIER_DISCOUNT_PCT=15
# Proxys de confiance pour l'adresse IP enregistrée dans le journal d'audit
TRUST_PROXY=loopback

# --- Portail client (QR code sur chaque table) ---
# false : les clients consultent la carte et appellent le serveur, mais ne commandent pas eux-mêmes
PUBLIC_ORDERING=true

# --- Connexion (anti force brute, anti attaque temporelle) ---
# Échecs tolérés sur 5 minutes : par identifiant, et par appareil (IP)
LOGIN_MAX_ATTEMPTS_ACCOUNT=5
LOGIN_MAX_ATTEMPTS_IP=10
# Second palier : échecs tolérés par identifiant sur 24 h (déblocage : réinitialiser le PIN)
LOGIN_MAX_ATTEMPTS_ACCOUNT_DAILY=20
# Durée minimale de toute réponse de connexion (ms), réussie ou non
LOGIN_MIN_RESPONSE_MS=800

# --- Interface servie par le serveur (production, application Android) ---
# Le serveur sert client/dist s'il existe (même origine que l'API). false pour désactiver.
SERVE_CLIENT=true
# CLIENT_DIST=/chemin/vers/client/dist
