DATABASE_URL="postgresql://resto:resto@localhost:5432/restoapp?schema=public"
PORT=4000
JWT_SECRET="changez-moi-en-production"
# Origines autorisées pour le front (séparées par des virgules)
CORS_ORIGIN="http://localhost:5173"

# En-tête des tickets de caisse
RESTAURANT_NAME="Le Maquis RestoApp"
RESTAURANT_ADDRESS="Avenue Kwame Nkrumah, Ouagadougou"
RESTAURANT_PHONE="+226 25 00 00 00"
RESTAURANT_NIF="00012345X"
RESTAURANT_RCCM="BF-OUA-2026-B-0000"
RECEIPT_FOOTER="Merci de votre visite et à bientôt !"
CURRENCY_LABEL="FCFA"

# Fuseau horaire du restaurant (statistiques par jour / par heure)
APP_TIMEZONE="Africa/Ouagadougou"

# --- Sécurité ---
# Cookie de session « Secure » (HTTPS). Laisser à true en production ; false uniquement
# pour tester depuis une tablette en http://IP-locale (les navigateurs refusent sinon le cookie).
COOKIE_SECURE=true
# Déconnexion serveur après N minutes sans requête (le verrouillage écran intervient avant)
SESSION_IDLE_MINUTES=30
# Remise cumulée maximale accordable par un caissier (% de l'addition), au-delà : gérant
MAX_CASHIER_DISCOUNT_PCT=15
# Proxys de confiance pour l'adresse IP enregistrée dans le journal d'audit
TRUST_PROXY=loopback
