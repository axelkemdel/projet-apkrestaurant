# =============================================================================
# Appresto — variables de PRODUCTION (Railway)
# Modèle uniquement : ne mettez JAMAIS de vraies valeurs dans ce fichier ni dans Git.
# Sur Railway : service Appresto → onglet « Variables » (ou « Raw Editor » pour tout coller).
# =============================================================================

NODE_ENV=production

# PostgreSQL Railway : référence au service de base (mot de passe fort généré par Railway).
# Dans l'onglet Variables, saisir littéralement :  ${{Postgres.DATABASE_URL}}
# Forme obtenue : postgresql://postgres:<mot-de-passe-fort>@postgres.railway.internal:5432/railway
DATABASE_URL="postgresql://postgres:CHANGER_MOT_DE_PASSE_FORT@postgres.railway.internal:5432/railway"

# Secret de signature des sessions : 64 octets aléatoires (128 caractères hexadécimaux).
#   openssl rand -hex 64
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Une valeur faible ou d'exemple empêche le serveur de démarrer en production.
JWT_SECRET="REMPLACER_PAR_128_CARACTERES_HEXADECIMAUX_ALEATOIRES"

# Port : attribué par Railway (variable PORT injectée automatiquement) — ne pas le fixer.
# PORT=

# --- HTTPS & cookies ---
# Railway sert l'application en HTTPS : cookies Secure obligatoires (false refusé en production)
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# Un proxy (Railway) devant le serveur : vraie IP client pour l'anti force brute et l'audit
TRUST_PROXY=1

# Origines autorisées : domaine HTTPS Railway (ou votre domaine) + application native.
# Aucune origine localhost implicite en production.
CORS_ORIGIN="https://appresto.up.railway.app,capacitor://localhost"

# --- Sessions & anti force brute ---
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS_ACCOUNT=5
LOGIN_MAX_ATTEMPTS_ACCOUNT_DAILY=20
LOGIN_MAX_ATTEMPTS_IP=10
LOGIN_MIN_RESPONSE_MS=800
MAX_CASHIER_DISCOUNT_PCT=15

# --- Photos des plats : volume Railway persistant monté sur /data (sinon perdues à chaque déploiement)
UPLOADS_DIR=/data/uploads

# --- Interface servie par le serveur (même origine que l'API, condition des cookies Strict)
SERVE_CLIENT=true

# --- Restaurant (tickets, statistiques)
APP_TIMEZONE="Africa/Ouagadougou"
RESTAURANT_NAME="Mon Restaurant"
RESTAURANT_ADDRESS="Adresse du restaurant"
RESTAURANT_PHONE="+226 00 00 00 00"
RESTAURANT_NIF=""
RESTAURANT_RCCM=""
RECEIPT_FOOTER="Merci de votre visite et à bientôt !"
RECEIPT_FOOTER_EN="Thank you for your visit, see you soon!"
CURRENCY_LABEL="FCFA"
PUBLIC_ORDERING=true
