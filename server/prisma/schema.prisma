// Appresto — schéma de base de données (PostgreSQL)
// Les montants sont stockés en entiers (FCFA, pas de centimes).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SERVEUR
  CUISINE
  CAISSE
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PENDING // envoyée, pas encore prise en charge
  PREPARING // en préparation
  READY // prête à servir
  SERVED // servie à table
  PAID // soldée
  CANCELLED
}

// Session d'un appareil : porte le jeton de rafraîchissement (cookie HttpOnly limité à
// /api/auth). Seule son empreinte SHA-256 est stockée ; il change à chaque
// rafraîchissement (rotation) et la réutilisation d'un ancien jeton révoque la session.
model AuthSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String
  // Empreinte du jeton précédent : tolérance de quelques secondes pour deux requêtes simultanées
  previousHash  String?
  rotatedAt     DateTime?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime // limite absolue (un service)
  revokedAt     DateTime?
  revokedReason String?
  ipAddress     String?
  userAgent     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Origine d'un bon : saisi par le personnel, ou commandé par le client via le QR code de sa table
enum OrderSource {
  STAFF
  CUSTOMER
}

enum Language {
  FR
  EN
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

// Poste de préparation vers lequel un plat est routé (écran cuisine ou bar)
enum Station {
  KITCHEN
  BAR
}

enum PaymentMode {
  CASH
  CARD
  ORANGE_MONEY
  TELECEL_CASH
}

model User {
  id             String   @id @default(cuid())
  name           String
  // Identifiant de connexion (code employé), saisi sur l'écran de connexion : aucune
  // liste de comptes n'est exposée avant authentification
  username       String   @unique
  role           Role
  pinHash        String
  isActive       Boolean  @default(true)
  // Incrémenté à chaque changement de PIN / rôle / désactivation : invalide les sessions ouvertes
  sessionVersion Int      @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())

  sessions AuthSession[]

  orders    Order[]
  payments  Payment[]
  discounts Discount[]
  auditLogs AuditLog[]
}

model Table {
  id       String      @id @default(cuid())
  number   Int         @unique
  capacity Int         @default(4)
  zone     String      @default("Salle") // ex : Salle, Terrasse, VIP
  status   TableStatus @default(FREE)
  // Jeton secret imprimé dans le QR code de la table (/qr/<jeton>). Un simple numéro
  // serait devinable : n'importe qui pourrait commander « à la table 5 » depuis chez lui.
  qrToken  String      @unique @default(uuid())

  // Demandes du client en attente (bouton « Appeler le serveur » / « L'addition »)
  callRequestedAt DateTime?
  billRequestedAt DateTime?

  orders    Order[]
  payments  Payment[]
  discounts Discount[]
  reviews   Review[]
}

model Category {
  id      String  @id @default(cuid())
  nameFr  String  @unique
  nameEn  String
  order   Int     @default(0)
  station Station @default(KITCHEN)

  items MenuItem[]
}

model MenuItem {
  id            String   @id @default(cuid())
  // Carte bilingue : le français fait référence (valeur canonique des options)
  nameFr        String
  nameEn        String
  descriptionFr String?
  descriptionEn String?
  price         Int
  categoryId    String
  isAvailable   Boolean  @default(true) // false = rupture de stock (affiché « Épuisé »)
  isArchived    Boolean  @default(false) // masqué de la carte (conservé pour l'historique)
  imageUrl      String? // /uploads/dishes/… (téléversé) ou URL externe (CDN)
  // Options de personnalisation, chaque libellé en deux langues :
  // { "cooking": [{ "fr": "Saignant", "en": "Rare" }], "sides": [{ "fr": "Frites", "en": "Fries" }],
  //   "extras": [{ "fr": "Fromage", "en": "Cheese", "price": 500 }] }
  options       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([categoryId])
}

model Order {
  id           String       @id @default(cuid())
  number       Int          @default(autoincrement()) // n° de bon lisible
  type         OrderType    @default(DINE_IN)
  tableId      String?
  serverId     String? // null : commande passée par le client (QR code)
  source       OrderSource  @default(STAFF)
  status       OrderStatus  @default(PENDING)
  totalAmount  Int          @default(0)
  paymentMode  PaymentMode?
  customerNote String?
  language     Language     @default(FR) // langue dans laquelle la commande a été prise
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  startedAt    DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  paidAt       DateTime? // addition soldée (le bon peut encore être en cuisine)

  table     Table?      @relation(fields: [tableId], references: [id])
  server    User?       @relation(fields: [serverId], references: [id], onDelete: Restrict)
  items     OrderItem[]
  payments  Payment[]
  discounts Discount[]
  review    Review?

  @@index([status])
  @@index([tableId, status])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  menuItemId   String
  // Copie bilingue figée au moment de la commande : la cuisine peut lire le bon
  // dans sa langue, même si la carte change ensuite
  nameFr       String
  nameEn       String
  quantity     Int
  unitPrice    Int // prix de base + suppléments, figé à la commande
  // Notes rapides codifiées, traduisibles (NO_ONION, NO_CHILI…) ; voir QUICK_NOTES
  quickNotes   String[] @default([])
  notes        String? // texte libre saisi par le serveur (non traduit automatiquement)
  // { "cooking": { "fr": "À point", "en": "Medium" }, "side": {…}, "extras": [{ "fr": "Fromage", "en": "Cheese", "price": 500 }] }
  modifiers    Json?
  station      Station  @default(KITCHEN)
  paidQuantity Int      @default(0) // quantité déjà réglée (paiement par articles)

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem      @relation(fields: [menuItemId], references: [id])
  paymentItems PaymentItem[]

  @@index([orderId])
}

// Versement encaissé en caisse. Un versement porte sur une addition : soit
// l'ensemble des bons ouverts d'une table, soit un bon à emporter. Une addition
// peut être soldée en plusieurs versements (addition partagée).
model Payment {
  id             String      @id @default(cuid())
  number         Int         @default(autoincrement()) // n° de ticket de caisse
  tableId        String?
  cashierId      String
  amount         Int // montant imputé sur l'addition
  mode           PaymentMode
  amountReceived Int // espèces remises par le client (= amount hors espèces)
  changeReturned Int         @default(0)
  reference      String? // n° de transaction Mobile Money / autorisation CB
  label          String? // ex : "Part 2/4", "Articles"
  createdAt      DateTime    @default(now())

  table   Table?        @relation(fields: [tableId], references: [id])
  cashier User          @relation(fields: [cashierId], references: [id])
  orders  Order[] // bons couverts par ce versement
  items   PaymentItem[] // articles réglés (paiement par sélection d'articles)

  @@index([tableId])
  @@index([createdAt])
}

// Détail d'un paiement par articles : quelle quantité de quelle ligne a été réglée
model PaymentItem {
  id          String @id @default(cuid())
  paymentId   String
  orderItemId String
  quantity    Int
  amount      Int

  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([paymentId])
  @@index([orderItemId])
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

// Remise accordée sur une addition (geste commercial, erreur…). Réduit le solde
// sans être un encaissement : le chiffre d'affaires reste la somme des Payment.
model Discount {
  id        String       @id @default(cuid())
  tableId   String?
  cashierId String
  kind      DiscountKind
  value     Int // pourcentage (PERCENT) ou montant saisi (AMOUNT)
  amount    Int // montant effectivement déduit, en FCFA
  reason    String
  createdAt DateTime     @default(now())

  table   Table?  @relation(fields: [tableId], references: [id])
  cashier User    @relation(fields: [cashierId], references: [id])
  orders  Order[]

  @@index([createdAt])
}

// Avis laissé par un client depuis le portail QR (une note par bon au plus)
model Review {
  id        String   @id @default(cuid())
  tableId   String
  orderId   String?  @unique
  rating    Int // 1 à 5
  comment   String?
  language  Language @default(FR)
  createdAt DateTime @default(now())

  table Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum AuditAction {
  ORDER_CANCELLED
  DISCOUNT_APPLIED
  MENU_PRICE_CHANGED
  MENU_ITEM_CREATED
  MENU_ITEM_DELETED
  PIN_RESET
  USER_CREATED
  USER_ROLE_CHANGED
  USER_STATUS_CHANGED
  LOGIN_LOCKED
  TABLE_QR_REGENERATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  ACCESS_DENIED
  MENU_ITEM_UPDATED
  MENU_CATEGORY_CHANGED
  TABLE_CHANGED
}

// Journal anti-fraude, en AJOUT SEUL : un trigger PostgreSQL refuse UPDATE et DELETE
// (voir la migration), même pour un gérant ayant accès à la base via l'application.
model AuditLog {
  id        String      @id @default(cuid())
  userId    String? // auteur de l'action (null : action anonyme, ex. tentatives de PIN)
  action    AuditAction
  details   Json
  timestamp DateTime    @default(now())
  ipAddress String?

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([timestamp])
  @@index([action, timestamp])
  @@index([userId, timestamp])
}
