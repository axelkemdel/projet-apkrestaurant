// RestoApp — schéma de base de données (PostgreSQL)
// Les montants sont stockés en entiers (FCFA, pas de centimes).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SERVEUR
  CUISINE
  CAISSE
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PENDING // envoyée, pas encore prise en charge
  PREPARING // en préparation
  READY // prête à servir
  SERVED // servie à table
  PAID // soldée
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

// Poste de préparation vers lequel un plat est routé (écran cuisine ou bar)
enum Station {
  KITCHEN
  BAR
}

enum PaymentMode {
  CASH
  CARD
  ORANGE_MONEY
  TELECEL_CASH
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      Role
  pinHash   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders   Order[]
  payments Payment[]
}

model Table {
  id       String      @id @default(cuid())
  number   Int         @unique
  capacity Int         @default(4)
  zone     String      @default("Salle") // ex : Salle, Terrasse, VIP
  status   TableStatus @default(FREE)

  orders   Order[]
  payments Payment[]
}

model Category {
  id      String  @id @default(cuid())
  name    String  @unique
  order   Int     @default(0)
  station Station @default(KITCHEN)

  items MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  categoryId  String
  isAvailable Boolean  @default(true)
  // Options de personnalisation :
  // { "cooking": ["Saignant", "À point"], "sides": ["Frites", "Riz"], "extras": [{ "name": "Fromage", "price": 500 }] }
  options     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([categoryId])
}

model Order {
  id           String       @id @default(cuid())
  number       Int          @default(autoincrement()) // n° de bon lisible
  type         OrderType    @default(DINE_IN)
  tableId      String?
  serverId     String
  status       OrderStatus  @default(PENDING)
  totalAmount  Int          @default(0)
  paymentMode  PaymentMode?
  customerNote String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  startedAt    DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  paidAt       DateTime? // addition soldée (le bon peut encore être en cuisine)

  table    Table?      @relation(fields: [tableId], references: [id])
  server   User        @relation(fields: [serverId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([status])
  @@index([tableId, status])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  menuItemId   String
  name         String // copie du nom au moment de la commande
  quantity     Int
  unitPrice    Int // prix de base + suppléments, figé à la commande
  notes        String? // ex : "sans oignon"
  // { "cooking": "À point", "side": "Frites", "extras": [{ "name": "Fromage", "price": 500 }] }
  modifiers    Json?
  station      Station @default(KITCHEN)
  paidQuantity Int     @default(0) // quantité déjà réglée (paiement par articles)

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem      @relation(fields: [menuItemId], references: [id])
  paymentItems PaymentItem[]

  @@index([orderId])
}

// Versement encaissé en caisse. Un versement porte sur une addition : soit
// l'ensemble des bons ouverts d'une table, soit un bon à emporter. Une addition
// peut être soldée en plusieurs versements (addition partagée).
model Payment {
  id             String      @id @default(cuid())
  number         Int         @default(autoincrement()) // n° de ticket de caisse
  tableId        String?
  cashierId      String
  amount         Int // montant imputé sur l'addition
  mode           PaymentMode
  amountReceived Int // espèces remises par le client (= amount hors espèces)
  changeReturned Int         @default(0)
  reference      String? // n° de transaction Mobile Money / autorisation CB
  label          String? // ex : "Part 2/4", "Articles"
  createdAt      DateTime    @default(now())

  table   Table?        @relation(fields: [tableId], references: [id])
  cashier User          @relation(fields: [cashierId], references: [id])
  orders  Order[] // bons couverts par ce versement
  items   PaymentItem[] // articles réglés (paiement par sélection d'articles)

  @@index([tableId])
  @@index([createdAt])
}

// Détail d'un paiement par articles : quelle quantité de quelle ligne a été réglée
model PaymentItem {
  id          String @id @default(cuid())
  paymentId   String
  orderItemId String
  quantity    Int
  amount      Int

  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([paymentId])
  @@index([orderItemId])
}
